<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="psx.droid"
    android:versionCode="20000"
    android:versionName="2.0.0">

    <uses-sdk android:minSdkVersion="10" android:targetSdkVersion="10" />

    <!-- Reading game images off the SD card. A normal permission on 2.3:
         granted at install time, never asked for at runtime. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <application android:label="PSX">
        <activity android:name="psx.droid.EmuActivity"
                android:label="PSX"
                android:screenOrientation="landscape"
                android:configChanges="orientation|keyboardHidden|keyboard"
                android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
