{
  "name": "homelab-game",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3100 --host=0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port=3100 --host=0.0.0.0",
    "lint": "tsc --noEmit",
    "test": "tsx tests/smoke.ts",
    "test:balance": "tsx tests/balance.ts",
    "test:render": "esbuild tests/render.tsx --bundle --platform=node --jsx=automatic --format=cjs --outfile=tests/.render.cjs --log-level=error && node tests/.render.cjs",
    "test:all": "npm run test && npm run test:balance && npm run test:render && npm run test:dom",
    "test:dom": "esbuild tests/dom.tsx --bundle --platform=node --jsx=automatic --format=cjs --outfile=tests/.dom.cjs --log-level=error --external:jsdom && node tests/.dom.cjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/app": "^7.1.2",
    "@capacitor/cli": "^7.6.10",
    "@capacitor/core": "^7.6.10",
    "@capacitor/splash-screen": "^7.0.5",
    "@capacitor/status-bar": "^7.0.6",
    "lucide-react": "^1.64.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/jsdom": "^30.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
